# FieldWise configuration. Copy to .env for local development:  cp .env.example .env
# Never commit .env. Only TURNSTILE_SITE_KEY is ever sent to the browser.

# --- Flask ---------------------------------------------------------------
# REQUIRED in production: long random string. Signs selection tokens.
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- AI audit ----------------------------------------------------------
# Kill switch: set to false to disable the "Run AI audit" feature entirely.
AI_ENABLED=true
# Anthropic key (server-side secret): create at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Claude Haiku 5.5 (low-cost).
AI_MODEL=claude-haiku-5-5
# Leave blank for the default: 4000.
AI_MAX_OUTPUT_TOKENS=
AI_MAX_INPUT_CHARS=24000
AI_TIMEOUT=45
# Total attempts per request (1-3), including retries after invalid output.
AI_MAX_ATTEMPTS=2

# --- Cloudflare Turnstile (required for the AI audit) -------------------
# Local testing: these are Cloudflare's official always-pass TEST keys (they work on localhost).
# Production: create a widget at https://dash.cloudflare.com -> Turnstile, add your domain, paste real keys.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Rate limiting -------------------------------------------------------
# memory:// is DEVELOPMENT-ONLY (per-process; not shared across gunicorn workers or instances).
# Production with >1 worker/instance: use Redis, e.g. redis://default:PASSWORD@HOST:6379
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_LOOKUP=30 per minute
RATELIMIT_AI=5 per minute;40 per day

# --- Caching & upstream timeouts -----------------------------------------
# Disk cache for genuine USDA tiles/outlines (safe to delete; regenerated on demand).
CACHE_DIR=instance/cache
USDA_TIMEOUT=20
CENSUS_TIMEOUT=6

# --- Privacy -------------------------------------------------------------
# Log selected coordinates (never with IPs). Off by default.
LOG_COORDINATES=false
